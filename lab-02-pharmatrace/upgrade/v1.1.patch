+    /** Version 1.1: the manufacturer records the expiry date of a batch, once. */
+    @Transaction()
+    public async SetExpiry(ctx: Context, id: string, date: string): Promise<void> {
+        const b = await this.load(ctx, id);
+        this.requireOrg(ctx, ['ManufacturerMSP'], 'set expiry dates');
+        if (
+            !/^\d{4}-\d{2}-\d{2}$/.test(date) ||
+            new Date(`${date}T00:00:00Z`).toISOString().slice(0, 10) !== date
+        ) {
+            throw new Error(`invalid date "${date}": use YYYY-MM-DD`);
+        }
+        if (b.expiryDate !== undefined) {
+            throw new Error(`batch ${id} already expires on ${b.expiryDate}`);
+        }
+        b.expiryDate = date;
+        await this.save(ctx, b, 'BatchUpdated');
+    }
