{
  "name": "pharmatrace-chaincode",
  "version": "1.0.0",
  "description": "Pharmaceutical batch traceability and recall, Book 4, Lab 2",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src",
    "test": "mocha",
    "coverage": "c8 mocha",
    "start": "fabric-chaincode-node start",
    "start:server": "fabric-chaincode-node server --chaincode-address=$CHAINCODE_SERVER_ADDRESS --chaincode-id=$CHAINCODE_ID",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "license": "Apache-2.0",
  "dependencies": {
    "fabric-contract-api": "2.5.8",
    "fabric-shim": "2.5.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "@types/node": "22.19.1",
    "@types/sinon": "17.0.4",
    "c8": "10.1.3",
    "chai": "4.5.0",
    "eslint": "10.12.0",
    "mocha": "11.7.5",
    "prettier": "3.6.2",
    "reflect-metadata": "0.1.14",
    "sinon": "21.0.0",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  }
}
