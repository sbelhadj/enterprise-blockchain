{
  "name": "parts-integration-service",
  "version": "1.0.0",
  "description": "REST service between the parts ledger and a maintenance system, Book 4, Lab 3",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --disable-warning=ExperimentalWarning dist/main.js",
    "reconcile": "node --disable-warning=ExperimentalWarning dist/reconcile.js",
