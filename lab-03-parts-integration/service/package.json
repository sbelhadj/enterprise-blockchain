    "lint": "eslint src test",
    "test": "mocha",
    "coverage": "c8 mocha"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@grpc/grpc-js": "1.14.6",
    "@hyperledger/fabric-gateway": "1.13.0",
    "@hyperledger/fabric-protos": "0.3.7",
    "express": "5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/chai": "4.3.20",
    "@types/express": "5.0.6",
    "@types/mocha": "10.0.10",
    "@types/node": "22.19.1",
    "c8": "10.1.3",
    "chai": "4.5.0",
    "eslint": "10.12.0",
    "mocha": "11.7.5",
    "prettier": "3.6.2",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  }
}
